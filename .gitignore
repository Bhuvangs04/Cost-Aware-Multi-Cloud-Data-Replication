# ==============================================================================
# Multi-Cloud Data Replication Platform - Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Security Credentials (NEVER COMMIT SECRETS)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
serviceAccount*.json
*.pem
*.key
*.pkcs12
*.pfx
credentials.json
client_secret*.json
aws_credentials

# ------------------------------------------------------------------------------
# 2. Python Bytecode, Caches & Packaging
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 3. Virtual Environments
# ------------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
virtualenv/

# ------------------------------------------------------------------------------
# 4. Testing, Code Coverage & Static Analysis
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.mypy_cache/
.ruff_cache/
htmlcov/
.tox/

# ------------------------------------------------------------------------------
# 5. Node.js & Frontend Artifacts
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.vite/

# ------------------------------------------------------------------------------
# 6. Celery, Redis & Background Workers
# ------------------------------------------------------------------------------
celerybeat-schedule*
celerybeat.pid
dump.rdb

# ------------------------------------------------------------------------------
# 7. Local Simulated Cloud Storage & SQLite Databases
# ------------------------------------------------------------------------------
local_simulated_cloud/
backend/local_simulated_cloud/
*.sqlite
*.sqlite3
*.db
backend/*.db
backend/*.sqlite3

# ------------------------------------------------------------------------------
# 8. Logs, Temporary Files & Scratch
# ------------------------------------------------------------------------------
*.log
logs/
temp/
tmp/
scratch/

# ------------------------------------------------------------------------------
# 9. Operating System & Editor Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor Settings
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

