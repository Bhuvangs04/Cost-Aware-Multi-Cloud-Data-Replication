# ==============================================================================
# Multi-Cloud Data Replication Platform - Environment Configuration
# ==============================================================================

PROJECT_NAME="Cost-Aware Multi-Cloud Data Replication"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in Docker, SQLite fallback for local test)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgrespassword"
POSTGRES_DB="multicloud_dr"
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/multicloud_dr"

# Redis & Celery Message Broker
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# Primary Cloud: AWS S3 Configuration
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_DEFAULT_REGION="us-east-1"
AWS_S3_BUCKET_NAME="multicloud-dr-primary-aws"

# Secondary Cloud: Google Cloud Storage (GCS) Configuration
GCP_PROJECT_ID="your-gcp-project-id"
GCP_SERVICE_ACCOUNT_KEY_PATH=""
GCP_BUCKET_NAME="multicloud-dr-replica-gcs"
GCP_DEFAULT_LOCATION="US"

# Simulation Mode Settings (Enable to operate without real cloud billing accounts)
SIMULATION_MODE=true
SIMULATED_STORAGE_PATH="./local_simulated_cloud"
SIMULATE_AWS_OUTAGE=false
SIMULATE_GCP_OUTAGE=false
SIMULATED_AWS_LATENCY_MS=0.0
SIMULATED_GCP_LATENCY_MS=0.0

# Cloud Pricing Assumptions (Configurable for research scenarios)
AWS_STORAGE_PRICE_PER_GB_MONTH=0.023
GCP_STORAGE_PRICE_PER_GB_MONTH=0.020
AWS_EGRESS_TO_GCP_PRICE_PER_GB=0.090
AWS_PUT_OPS_PRICE_PER_1K=0.005
GCP_PUT_OPS_PRICE_PER_1K=0.005

# Disaster Recovery Health Probe Settings
HEALTH_PROBE_INTERVAL_SECONDS=10
CONSECUTIVE_FAILURE_THRESHOLD=3
HEALTH_RESTORE_THRESHOLD=3

